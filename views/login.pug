extends layout
block content
  img(src="/images/sciencekit-logo.png",alt="ScienceKit")
  h1 Sign in
  form(action="/login",method="post")
    label(for="username") Username
    input#username(name="username",autocomplete="username",required)
    label(for="password") Password
    input#password(name="password",type="password",autocomplete="current-password",minlength="8",required)
    p Use at least 8 characters, up to 72 UTF-8 bytes.
    button(type="submit") Sign in
  p
    a(href="/signup") Create an account
  p
    a(href=clientUrl) Return to ScienceKit
